{
  "outputDirectory": "public",
  "buildCommand": null,
  "cleanUrls": false,
  "headers": [
    { "source": "/content.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/admin.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/assets/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
